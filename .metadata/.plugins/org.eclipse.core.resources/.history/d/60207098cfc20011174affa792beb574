package in.thiru.patterns;

public class Example10 {

	public static void main(String[] args) {
		
		System.out.println("started pattern");

		for (int i = 5; i <= 1; i++) {

			for (int j = 5; j <= 1; j++) {

				System.out.print(i);

			}

			System.out.println();

		}

		
		
		System.out.println("ended the pattern");
	}

}
