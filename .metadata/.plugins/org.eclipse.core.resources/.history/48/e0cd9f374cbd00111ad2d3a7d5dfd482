package in.thiru.operators;

public class No05Operators {

	public static void main(String[] args) {

		int a = 10;
		
		//increment pre and post increment
		//(a++)-> Increasing by 1 in the next line
		
		System.out.println(a++); 
		System.out.println(a++); //10+1=11
		System.out.println(a++); //11+1=12
		System.out.println(a++); 
		System.out.println(a++); 
		System.out.println(a++); 
		System.out.println(a++); 
		System.out.println(a++); 
		

		

	}

}
