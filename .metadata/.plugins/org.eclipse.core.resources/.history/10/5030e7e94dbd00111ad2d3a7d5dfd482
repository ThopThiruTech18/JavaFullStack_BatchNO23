package in.thiru.operators;

public class No08Operators {

	public static void main(String[] args) {

		int a = 10;
		
		
		System.out.println(a--); //10
		System.out.println(--a); //10-1-1=8
		System.out.println(++a); //8+1=9
		System.out.println(++a); //9+1=10
		System.out.println(++a); //10+1=11
		System.out.println(a++); //11
		System.out.println(a--); //11+1=12
		System.out.println(++a); //12-1=11
		System.out.println(--a); //10
		System.out.println(a--); //10
		System.out.println(a--); //10
		System.out.println(a--); //10
		System.out.println(--a); //10
		System.out.println(--a); //10
		System.out.println(--a); //10
		System.out.println(++a); //10
		System.out.println(a++); //10
		System.out.println(a++); //10
		System.out.println(a++); //10
		System.out.println(--a); //10

		
		
		
		
		

		

	}

}
