package in.thiru.patterns;

public class Example08 {

	public static void main(String[] args) {
		
		System.out.println("started pattern");  //5x5 =25
		
		int k = 1;

		for (char i = 'A'; i <= 'E; i++) {

			for (int j = 1; j <= 5; j++) {

				System.out.print((k++)+"   ");

			}

			System.out.println();

		}

		
		
		System.out.println("ended the pattern");
	}

}
