package in.thiru.patterns;

public class Example19 {

	public static void main(String[] args) {
		
		System.out.println("started pattern");

		
		int a=1;
		
		for (int i = 1; i <=5; i++) {
			
			
			for (int j = 1; j <=i; j++) {
				
				System.out.print((a++)+ "  ");
				
			}
			
			System.out.println();
			
		}

		
		
		System.out.println("ended the pattern");
	}

}
