package in.thiru.operators;

public class No08Operators02 {

	public static void main(String[] args) {

		int a = 10;
		
		
		System.out.println(a--); //10
		System.out.println(--a); //10-1-1=8
		System.out.println(++a); //8+1=9
		System.out.println(++a); //9+1=10
		System.out.println(++a); //10+1=11
		System.out.println(a++); //11
		System.out.println(a--); //11+1=12
		System.out.println(++a); //12-1+1=12
		System.out.println(--a); //12-1=11
		System.out.println(a--); //11
		System.out.println(a--); //11-1=10
		System.out.println(a--); //10-1=9
		System.out.println(--a); //9-1-1=7
		System.out.println(--a); //7-1=6
		System.out.println(--a); //6-1=5
		System.out.println(++a); //5+1=6
		System.out.println(a++); //6
		System.out.println(a++); //6+1=7
		System.out.println(a++); //7+1=8
		System.out.println(--a); //8+1-1=8

		
		
		
		
		

		

	}

}
