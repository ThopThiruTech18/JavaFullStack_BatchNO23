package in.thiru.loops;

public class Example08 {

	public static void main(String[] args) {

		
		
		for (int i = 1; i <= 10; i++) {
			
			System.out.println(i);

		}
		System.out.println(i);

		int start = 1;
		int end = 10;

		while (start <= end) {
			
			int number=10;

			start = start + 1;

			System.out.println(start);
			System.out.println(end);

		}
		System.out.println(number);

		System.out.println(start);
		System.out.println(end);

	}

}
